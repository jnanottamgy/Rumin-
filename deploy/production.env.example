# RUMIN production settings (Phase 10). Copy to .env.production at the repository root,
# set every value, and keep the file out of version control (it is ignored). See
# docs/deployment.md.

# The release being run: images are tagged with it, and rollback runs the previous one.
RUMIN_VERSION=0.1.0

# The database passwords, long and random (e.g. `openssl rand -hex 32`): the API's role
# `rumin`, and the `postgres` superuser used only for administration (restores). They are
# set when the database volume is first created; changing them later needs ALTER ROLE.
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=

# The host name people use, and the origin the plain-HTTP port redirects to.
RUMIN_SERVER_NAME=rumin.example.org
RUMIN_PUBLIC_ORIGIN=https://rumin.example.org
RUMIN_HTTP_PORT=80
RUMIN_HTTPS_PORT=443

# A directory holding fullchain.pem and privkey.pem for RUMIN_SERVER_NAME.
RUMIN_TLS_DIR=/etc/letsencrypt/live/rumin.example.org

# Optional: addresses that may read GET /metrics on the API without signing in (an
# internal scraper on the same host network). Empty: administrators only.
RUMIN_METRICS_ALLOWED_CLIENTS=

# Optional: the AI Analyst's language model. "grounded" (the default) uses no model. To use
# one, set "anthropic", a model identifier and a key — and read docs/security.md first:
# questions and the records the Analyst gathers are then sent to the provider.
RUMIN_ANALYST_PROVIDER=grounded
RUMIN_ANALYST_MODEL=
RUMIN_ANTHROPIC_API_KEY=
