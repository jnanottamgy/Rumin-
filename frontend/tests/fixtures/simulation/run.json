  "limitations": [
    {
      "id": "L1",
      "text": "The model shows the arithmetic consequence of the inputs and assumptions. It is not a forecast of what will happen, and not investment advice."
    },
    {
      "id": "L2",
      "text": "Passenger demand, capacity and schedules do not respond to fares or costs."
    },
    {
      "id": "L3",
      "text": "Competitors' responses and market share are not modelled."
    },
    {
      "id": "L4",
      "text": "Only the benchmark-linked fuel cost is modelled. Ad-valorem taxes that scale with the price are not captured, so a real fuel bill can move more than the benchmark."
    },
    {
      "id": "L5",
      "text": "The elasticity, lags, hedge terms and pass-through are assumptions with stated defaults. None has been estimated from data in RUMIN."
    },
    {
      "id": "L6",
      "text": "Monthly steps: timing within a month is ignored, and seasonality is not modelled."
    },
    {
      "id": "L7",
      "text": "Operating profit only: no interest, tax, hedge accounting, working capital or cash-flow timing."
    }
  ],
