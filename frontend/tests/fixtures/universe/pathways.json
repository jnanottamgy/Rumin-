          "default": "0"
        }
      ],
      "statements": [
        {
          "id": "A1",
          "text": "Everything the model does not include stays at its baseline: the US-dollar amounts, volumes, prices in every currency, other costs and financing."
        },
        {
          "id": "A2",
          "text": "US-dollar revenue and costs accrue evenly through the year: each month carries one twelfth."
        },
        {
          "id": "A3",
          "text": "Dollar amounts are converted at the month's exchange rate. Dollar prices, volumes and demand do not respond to the exchange rate."
        },
        {
          "id": "A5",
          "text": "Hedges fix the baseline exchange rate for the hedged share during the first months of cover, then expire; they are not rolled over. Revenue and cost hedges are separate."
        }
      ],
      "sign": null,
      "active": true
