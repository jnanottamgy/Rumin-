      "simulation": "computed",
      "label": "converts dollar revenue",
      "group": "fx_exposure",
      "equations": [
        {
          "id": "E1",
          "name": "Baseline US-dollar revenue in the reporting currency",
          "formula": "R$ = U_R × X₀"
        },
        {
          "id": "E7",
          "name": "Change in revenue",
          "formula": "Δr(m) = r₀ × (1 − h_R(m)) × (q(m) − 1)"
        }
      ],
