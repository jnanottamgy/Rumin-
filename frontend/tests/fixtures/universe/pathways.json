      "equations": [
        {
          "id": "E6",
          "name": "Jet fuel log-change",
          "formula": "ℓ(m) = β · ln(1 + c) · 𝟙[S + L ≤ m ≤ E + L] + ln(1 + s) · 𝟙[S ≤ m ≤ E]"
        }
      ],
      "rule": "T1",
      "edge": {
        "edge_key": "e-ea305310288a3f88",
        "edge_type": "influences",
        "relationship": "influences",
        "evidence_status": "model_assumption",
        "is_illustrative": true
      },
      "coefficient": "1",
      "lag_months": 1,
      "window": {
        "first_month": 2,
        "last_month": null
      },
      "assumptions": [
        {
          "id": "crude_pass_through",
          "label": "Crude-to-jet-fuel elasticity (β)",
          "value": "1",
          "unit": "elasticity (dimensionless)",
          "source": "default",
          "default": "1"
        },
        {
          "id": "crude_pass_through_lag",
          "label": "Crude-to-jet-fuel lag",
          "value": "1",
          "unit": "months",
          "source": "user",
          "default": "0"
        }
      ],
      "statements": [
        {
          "id": "A4",
          "text": "Scenario changes are step changes: they take effect in the start month and last for the stated duration (to the end of the horizon unless one is set), after which the changed variables return to their baselines. Every change in a run shares this timing."
        },
        {
          "id": "A5",
          "text": "Jet fuel responds to crude oil with a constant elasticity β after a lag: ln(jet fuel) changes by β × ln(1 + crude change). With β = 1 the refining margin stays a constant proportion of the price."
        }
      ],
      "sign": null,
      "active": true
    },
