# =============================================================================
# RUMIN — environment configuration template
# =============================================================================
# Copy this file to `.env` in the repository root:   cp .env.example .env
#
# * `.env` is git-ignored. Never commit real credentials.
# * Every variable is optional: the defaults below are safe for local development.
# * The backend reads variables prefixed with RUMIN_ (see backend/app/core/config.py).
# * The frontend build only exposes variables prefixed with VITE_ to browser code.
#   Anything prefixed with VITE_ is PUBLIC — never put secrets in VITE_ variables.
# =============================================================================

# --- Backend -----------------------------------------------------------------

# development | test | production
RUMIN_ENVIRONMENT=development

# SQLAlchemy database URL.
# Default (when unset): a SQLite file at backend/rumin.db — no server required.
# PostgreSQL (see docker-compose.yml; requires the `postgres` extra):
# RUMIN_DATABASE_URL=postgresql+psycopg://rumin:change-me-local-only@localhost:5432/rumin

# Comma-separated list of browser origins allowed to call the API directly.
# (In development the Vite dev server proxies /api, so CORS is only needed when
#  the frontend is served from a different origin than the API.)
RUMIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DEBUG | INFO | WARNING | ERROR
RUMIN_LOG_LEVEL=INFO

# Serve interactive OpenAPI docs at /docs and /redoc.
RUMIN_DOCS_ENABLED=true

# Requests with a larger body are rejected with HTTP 413.
RUMIN_MAX_REQUEST_BODY_BYTES=65536

# --- Data ingestion (command line only; no key is needed) -----------------------

# The World Bank Indicators API. https only (http is accepted for localhost only).
# RUMIN_WORLDBANK_BASE_URL=https://api.worldbank.org/v2
# Seconds between two World Bank requests; request timeout; attempts per request.
# RUMIN_WORLDBANK_MIN_INTERVAL_SECONDS=1.0
# RUMIN_PROVIDER_TIMEOUT_SECONDS=20
# RUMIN_PROVIDER_MAX_ATTEMPTS=4
# Largest price file accepted for import, in bytes (10 MB).
# RUMIN_MAX_IMPORT_FILE_BYTES=10485760
# Keep the exact bytes of every response and imported file (gzip-compressed).
# RUMIN_STORE_SOURCE_BODIES=true

# --- AI Analyst (Phase 7) --------------------------------------------------------

# "grounded" (default): RUMIN composes every answer itself from its tools; no key needed.
# "anthropic": a Claude model answers through the official SDK, with the same tools and
# the same grounding check; if it fails, the grounded composer answers instead.
# RUMIN_ANALYST_PROVIDER=grounded
# Only for "anthropic". The key stays in the backend and is never sent to the browser.
# RUMIN reads only these RUMIN_ settings: ANTHROPIC_* variables are ignored.
# RUMIN_ANTHROPIC_API_KEY=
# The model to use (required for "anthropic"; there is no default). See the Anthropic docs.
# RUMIN_ANALYST_MODEL=
# RUMIN_ANTHROPIC_BASE_URL=https://api.anthropic.com
# RUMIN_ANALYST_THINKING=adaptive
# Limits: tokens per model reply, model requests and tool calls per question, seconds per
# question, and input+output tokens per day (beyond it the grounded composer answers).
# RUMIN_ANALYST_MAX_TOKENS=4096
# RUMIN_ANALYST_MAX_MODEL_REQUESTS=6
# RUMIN_ANALYST_MAX_TOOL_CALLS=12
# RUMIN_ANALYST_DEADLINE_SECONDS=90
# RUMIN_ANALYST_DAILY_TOKEN_BUDGET=2000000

# --- Frontend ------------------------------------------------------------------

# Base URL of the API as seen by the browser. Leave empty to use same-origin
# requests (recommended): the Vite dev server proxies /api and /health.
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api and /health (Node-side only, not exposed).
RUMIN_API_PROXY_TARGET=http://127.0.0.1:8000

# --- Local PostgreSQL via docker compose (development only) --------------------
POSTGRES_USER=rumin
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rumin
