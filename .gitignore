# ---------------------------------------------------------------------------
# RUMIN — files that must never be committed
# ---------------------------------------------------------------------------

# Environment files (may contain secrets). Only .env.example is committed.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local databases (SQLite files are created by migrations/seed)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Node / frontend
node_modules/
frontend/dist/
frontend/coverage/
*.tsbuildinfo
.vite/

# Logs and OS/editor noise
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Temporary file written by `make audit`
backend/.audit-requirements.txt

# Database backups (scripts/backup.sh): personal data, never committed
backups/
